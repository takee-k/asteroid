{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "Build Raylib App",
            "command": "C:\\Users\\Windows\\Downloads\\winlibs-x86_64-posix-seh-gcc-16.1.0-mingw-w64msvcrt-14.0.0-r4\\mingw64\\bin\\gcc.exe",
            "args": [
                "-g",
                "${file}",
                "-I${workspaceFolder}/raylib/raylib-6.0_win64_mingw-w64/include",
                "${workspaceFolder}/raylib/raylib-6.0_win64_mingw-w64/lib/libraylib.a",
                "-lopengl32",
                "-lgdi32",
                "-lwinmm",
                "-o",
                "${workspaceFolder}/${fileBasenameNoExtension}.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "windows": {
                "options": {
                    "cwd": "${workspaceFolder}",
                    "shell": {
                        "executable": "cmd.exe",
                        "args": ["/d", "/c"]
                    }
                }
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}